{
  "name": "@scanlyfix/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types/monitor-diff.ts": "./src/types/monitor-diff.ts",
    "./queries/web-vitals.ts": "./src/queries/web-vitals.ts",
    "./queries/psi-cache.ts": "./src/queries/psi-cache.ts",
    "./dns-checker.ts": "./src/dns-checker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@scanlyfix/checks": "workspace:*",
    "@scanlyfix/repo-checks": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.11"
  }
}
