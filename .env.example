DATABASE_URL=
# Salt for hashing visitor IP addresses before storage. Any long random string.
IP_HASH_SALT=

# Auth (Phase 3). Anon/publishable key only — never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Billing (Phase 4). Absent means upgrading is unavailable; everything else works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
# Where Stripe returns the customer to. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Monitoring (Phase 5). Leave unset in development — the client infers dev mode.
# Both are required in production, from the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# PageSpeed Insights (Phase 6). Only used by `deep` scans, and skipped entirely
# when unset: without a key the shared anonymous quota is spent most of every
# day, so a keyless call is 30 seconds spent on a guaranteed 429. Free from the
# Google Cloud console with the PageSpeed Insights API enabled (25k/day).
PAGESPEED_API_KEY=

# Browser tier (Phase 6). Both required together, and only used by `deep`
# scans. Run the service with `pnpm --filter @darvin/scanner start`; without
# these the rendered-DOM and axe-core checks stay silent.
# The token is a shared secret you choose — the service refuses to start
# without one, because it drives a real browser to any URL it is given.
DARVIN_SCANNER_URL=
DARVIN_SCANNER_TOKEN=
